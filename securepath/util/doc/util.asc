== string_util.hpp
Provides functions for conversions between std::string and std::wstring and a function to convert std::string to hex format.

[source, c++]
....
#include <securepath/util/string_util.hpp>
std::string s = "string";
std::wstring ws = L"string";

ws.compare(to_wstring(s))); // 0
s.compare(to_string(ws))); // 0

to_hex("0", ""); // == "30"
to_hex("AB", "-"); // == "41-42"
to_hex("AA", "ABC"); // == "41ABC41"
to_hex("", "X"); // == ""

....

== sync_wait.hpp

`sync_wait(task)` runs a task from non-coroutine code, blocking the calling thread until the
task completes, and returns its result (or rethrows its exception).

== task.hpp

Lazy coroutine task type: the body starts running when the task is awaited and the awaiting
coroutine resumes once it completes. Await a task once; use `sync_wait()` to run one from
non-coroutine code.

[source, c++]
....
#include <securepath/util/sync_wait.hpp>
#include <securepath/util/task.hpp>

securepath::task<int> compute() {
	co_return 42;
}

securepath::task<int> compute_more() {
	co_return co_await compute() + 1;
}

int value = securepath::sync_wait(compute_more()); // 43
....

== timer.hpp

[source, c++]
....
#include <securepath/util/timer.hpp>

securepath::timer t; // starts timer (saves current time)
t.elapsed_seconds(); // returns elapsed seconds since start/reset in uint64_t format
t.elapsed_milliseconds(); // elapsed milliseconds in uint64_t format
t.elapsed_microseconds(); // elapsed microseconds in uint64_t format
t.elapsed_nanoseconds(); // elapsed nanoseconds in uint64_t format
t.reset(); // resets timer (saves current time)
....

== typelist.hpp

[source, c++]
....

#include <securepath/util/typelist.hpp>
#include <iostream>

struct custom_type {
};

using my_types = typelist<test_tag<bool, 1>,
			test_tag<int, 2>,
			test_tag<custom_type, 3> >;

void test_type() {

	using first = get_element<begin<my_types>::type, end<my_types>::type, 0>::type;
 	using second = get_element<begin<my_types>::type, end<my_types>::type, 1>::type;
 	using third = get_element<begin<my_types>::type, end<my_types>::type, 2>::type;
 	
 	std::cout << std::is_same<first::type, bool>::value;
 	std::cout << std::is_same<second::type, int>::value;
 	std::cout << std::is_same<third::type, custom_type>::value << std::endl;

 	std::cout << first::tag == 1 << second::tag == 2 << third::tag == 3 << std::endl;

}
....
Output is:
....
111
111
....

