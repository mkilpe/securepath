== print_align.hpp

[source, c++]
....
#include <securepath/util/print_align.hpp>

std::ostringstream os;
{
	print_align p(os);
	p << "hello";
}
os.str(); // == "test"
	
os.clear();
os.str("");
	
{
	print_align p(os);
	p << "test";
	p.align(2);
}

os.str(); // == "te"
....


== print_util.hpp

[source, c++]
....
#include <securepath/util/print_util.hpp>

std::ostringstream os;
print_list(os, ""s, "-");
os.str(); // == ""

os.clear();
os.str("");

print_list(os, "test test"s, "-");
os.str(); // == "t-e-s-t- -t-e-s-t"

os.clear();
os.str("");

std::vector<int> v = {1,2,3,4};
print_list(os, v, "");
os.str(); // == "1234"
....

== resume_on.hpp

`resume_on(executor, awaitable)` awaits the awaitable and resumes the awaiting coroutine on the
executor instead of on the thread that completed the awaitable; the result or exception is
passed through. `schedule(executor)` is the bare hop. `executor` is anything with an
`execute(work)` member, e.g. an asio executor or strand.

[source, c++]
....
#include <securepath/util/resume_on.hpp>

securepath::task<void> handle(key_client::client& client, asio::strand<...> strand,
	crypto::public_key_id id) {
	auto key = co_await securepath::resume_on(strand, client.async_find_key(id));
	// runs on the strand, not on the key client io thread
}
....

