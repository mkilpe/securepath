== Info

== byte_order.hpp

== command_parser.hpp

Tool to make command line menu and parse command line arguments.

TIP: Use it in try-block because it may throw exception on invalid arguments.

[source, c++]
....

#include <securepath/util/command_parser.hpp>
#include <iostream>
#include <string>

struct parameters : securepath::command_parser {
	
	bool help = false;
	bool print = false;
	std::string name;
	int number = 0;

parameters() {
  
  add(help, "help", "h", "show help");
  add(print, "print", "", "print");
  add(name, "host", "n", "print name");
  add(number, "number", "", "number");

}

};

void function print_name(parameters const& p) {
	if(!p.name.empty()) {
		std::cout << p.name << std::endl;
	}
	for(int i = 0; i < p.number; ++i) {
		std::cout << i << std::endl;
	}
}

int main(int argc, char* args[]) {
	int ret = 0;
	try {
		parameters p;
		p.parse(argc, args);

		if(p.help) {
			std::cout << "Example menu\n";
			p.print_help(std::cout);
		} else if(p.print) {
			print_name(p);
		}
	} catch(...) {
	}
	return ret;
}
....

