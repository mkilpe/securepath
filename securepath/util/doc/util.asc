== conversions.hpp

NOTE: Throws exception if hex string is not divisible by 2 or there are invalid characters in hex format.

[source, c++]
....
#include <securepath/util/conversions.hpp>

// from_hex("AAA") throws invalid_argument because of invalid length
// from_hex("AAAJ"), throws invalid_argument because J is not valid hex character

octet_vector o1 = {16,255};
to_hex(o1); // "10FF"

octet_vector o2 = {0};
to_hex(o2); // "00"

std::string s = "02AF2BE203DC";
to_hex(from_hex(s1)); // result is s
....

== debug_print.hpp
[source, c++]
....
#include <securepath/util/debug_print.hpp>
#include <securepath/log/backend/backend.hpp>
#include <securepath/log/backend/file_output.hpp>

using namespace securepath;

log::backend::add_backend<log::backend::file_output>("debug", "debug.log");
debug_print("debug message {}{}", 1, 'a');

// prints "debug message 1a" to std::cout and debug.log
