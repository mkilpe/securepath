== error.hpp

[source, c++]
....
#include <securepath/util/error.hpp>

function error_example() {
	
	using namespace securepath;

	errc e_code = errc::exception_occurred;
	std::error_code err_code = make_error_code(e_code);

	error err(err_code, "error_msg");

	std::cout << err.message() << " " << (int)err.code().value() << " ";
	std::cout << std::string(err.code().category().name() << std::endl;

}
....
Output is "error_msg 2 securepath error"

== future.hpp

Single-shot `future<T>`/`promise<T>` pair for asynchronous calls. The consumer either blocks
with `get()` or awaits the future in a coroutine with `co_await`; the awaiting coroutine is
resumed on whichever thread completes the promise. The promise completes the future at most
once; later completions are ignored.

[source, c++]
....
#include <securepath/util/future.hpp>

securepath::promise<int> pr;
securepath::future<int> fut = pr.get_future();
// io thread: pr.set_value(42); or pr.set_exception(...)
int value = co_await fut; // or fut.get() to block
....

== octet_vector.hpp
[source, c++]
....
#include <securepath/util/octet_vector.hpp>

octet_vector vec = {'a', 'b', 'c', 'd', 'e', 'f', 'g'};
octet_vector o1 = securepath::subbuffer(vec, vec.size()); // empty
octet_vector o2 = securepath::subbuffer(vec, 0); // {'a', 'b', 'c', 'd', 'e', 'f', 'g'}
octet_vector o3 = securepath::subbuffer(vec, 4); // {'e', 'f', 'g'}
octet_vector o4 = securepath::subbuffer(vec, 4, 1); // {'e'}
octet_vector o5 = securepath::subbuffer(vec, 4, 2); // {'e', 'f'}


